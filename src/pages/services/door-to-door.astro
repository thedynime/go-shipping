---
import PublicLayout from '../../layouts/PublicLayout.astro';
import QuoteCalculatorIsland from '../../components/marketing/QuoteCalculatorIsland';
import { getSiteOrigin } from '../../server/utils/domain';

const siteOrigin = getSiteOrigin(Astro.request);
const canonicalUrl = `${siteOrigin}/services/door-to-door`;

const faqItems = [
  {
    q: "What does Door-to-Door (DDP) shipping include?",
    a: "DDP (Delivered Duty Paid) includes pickup/receiving at our China warehouses, export documentation, international air or sea freight, Bangladesh customs duty assessment, VAT, AIT, port clearance, and final delivery directly to your home, office, or commercial warehouse in Bangladesh."
  },
  {
    q: "Do I need an Import Registration Certificate (IRC) or Tin?",
    a: "No. For our all-inclusive DDP door-to-door service, online sellers and individuals do not need their own IRC, BIN, or commercial import license. Go Shipping handles all formal commercial clearances under our authorized logistics license."
  },
  {
    q: "Which areas in Bangladesh do you deliver to?",
    a: "We deliver across all 64 districts in Bangladesh. In Dhaka metropolitan areas, deliveries are made via our dedicated dispatch vans. For other divisions and districts, we partner with reliable express domestic courier networks."
  },
  {
    q: "Are there any hidden costs after the cargo arrives in Bangladesh?",
    a: "Zero hidden charges. The rate quoted by Go Shipping per kg (for air) or per CBM (for sea) is fully all-inclusive. You will never be asked for additional customs bribes, demurrage, or clearance fees."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${siteOrigin}/services/door-to-door#service`,
      "name": "China to Bangladesh Door-to-Door DDP Delivery Services",
      "serviceType": "Door to Door Freight Forwarding",
      "provider": {
        "@type": "LogisticsService",
        "@id": `${siteOrigin}/#organization`,
        "name": "Go Shipping"
      },
      "areaServed": [
        { "@type": "Country", "name": "Bangladesh" },
        { "@type": "Country", "name": "China" }
      ],
      "description": "All-inclusive DDP China to Bangladesh door-to-door logistics with zero customs hassle, customs clearance in Dhaka & Chittagong, and direct delivery across all 64 districts."
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteOrigin },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteOrigin}/services` },
        { "@type": "ListItem", "position": 3, "name": "Door-to-Door Delivery", "item": canonicalUrl }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<PublicLayout
  title="Door-to-Door Delivery China to Bangladesh | All-Inclusive DDP Logistics — Go Shipping"
  description="Hassle-free China to Bangladesh door-to-door shipping service. We collect from China suppliers, handle Bangladesh customs clearance, and deliver to your doorstep with zero hidden fees."
  keywords="door to door shipping china to bangladesh, ddp delivery bangladesh, china cargo home delivery dhaka chittagong, customs duty paid shipping china bd, all inclusive logistics china bangladesh"
  currentPath="/services/door-to-door"
  image="/og/og-door-to-door.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <!-- Hero Banner -->
  <section class="bg-gradient-to-b from-white via-slate-50/50 to-white text-slate-900 py-10 sm:py-14 lg:py-18 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs font-mono text-[#EA1D2C] uppercase tracking-wider mb-2.5 sm:mb-3">
        <a href="/services" class="hover:underline text-slate-500">Services</a>
        <span class="text-slate-300">/</span>
        <span class="text-[#EA1D2C] font-semibold">DDP Freight</span>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-8 space-y-3 sm:space-y-4">
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight font-['Manrope',sans-serif] leading-[1.15] text-[#11181E]">
            China to Bangladesh Door-to-Door Delivery
          </h1>
          <p class="text-slate-600 text-xs sm:text-sm lg:text-base max-w-2xl leading-relaxed">
            The easiest way to import from China. Send products from your 1688, Alibaba, Taobao, or factory suppliers straight to our Guangzhou, Yiwu, or Shenzhen warehouses, and receive them directly at your address in Bangladesh.
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-4 pt-2 sm:pt-4 text-xs">
            <div class="bg-white border border-slate-200 shadow-2xs p-3 sm:px-4 sm:py-2.5 rounded-lg">
              <span class="text-slate-500 block text-[10px] uppercase font-mono font-semibold">Customs Duty</span>
              <span class="font-bold text-slate-900 text-xs sm:text-sm">100% Included</span>
            </div>
            <div class="bg-white border border-slate-200 shadow-2xs p-3 sm:px-4 sm:py-2.5 rounded-lg">
              <span class="text-slate-500 block text-[10px] uppercase font-mono font-semibold">IRC Requirement</span>
              <span class="font-bold text-slate-900 text-xs sm:text-sm">Not Required</span>
            </div>
            <div class="bg-white border border-slate-200 shadow-2xs p-3 sm:px-4 sm:py-2.5 rounded-lg">
              <span class="text-slate-500 block text-[10px] uppercase font-mono font-semibold">Coverage</span>
              <span class="font-bold text-slate-900 text-xs sm:text-sm">All 64 Districts</span>
            </div>
            <div class="bg-white border border-slate-200 shadow-2xs p-3 sm:px-4 sm:py-2.5 rounded-lg">
              <span class="text-slate-500 block text-[10px] uppercase font-mono font-semibold">Shipment Modes</span>
              <span class="font-bold text-slate-900 text-xs sm:text-sm">Air &amp; Sea</span>
            </div>
          </div>
        </div>
        <div class="lg:col-span-4 flex flex-col gap-2.5 sm:gap-3">
          <a href="#quote-calculator" class="min-h-[44px] flex items-center justify-center w-full text-center py-3 px-6 bg-[#EA1D2C] hover:bg-[#D41523] text-white font-bold text-xs sm:text-sm rounded-lg transition-colors shadow-xs">
            Get Instant DDP Quote
          </a>
          <a href="https://wa.me/8801797252627?text=Hello%20Go%20Shipping%2C%20I%20want%20Door%20to%20Door%20delivery%20from%20China." target="_blank" rel="noreferrer" class="min-h-[44px] flex items-center justify-center w-full text-center py-3 px-6 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm rounded-lg transition-colors shadow-xs">
            WhatsApp Door-to-Door Desk
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Highlights -->
  <section class="py-10 sm:py-16 lg:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-14 lg:space-y-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
      <div class="p-5 sm:p-6 rounded-xl bg-white border border-slate-200 space-y-2.5 sm:space-y-3 shadow-2xs">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-red-50 text-[#EA1D2C] flex items-center justify-center font-bold text-base sm:text-lg font-mono">
          01
        </div>
        <h3 class="text-base sm:text-lg font-bold text-slate-900 font-['Manrope']">Zero Customs Bureaucracy</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          No port visits, no dealing with clearing agents, and no surprise duty assessments. We handle all customs paperwork and regulatory clearances smoothly.
        </p>
      </div>

      <div class="p-5 sm:p-6 rounded-xl bg-white border border-slate-200 space-y-2.5 sm:space-y-3 shadow-2xs">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-red-50 text-[#EA1D2C] flex items-center justify-center font-bold text-base sm:text-lg font-mono">
          02
        </div>
        <h3 class="text-base sm:text-lg font-bold text-slate-900 font-['Manrope']">Multi-Supplier Consolidation</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Order from multiple Chinese factories or online vendors. We receive each parcel at our warehouse, combine them into a single consolidated cargo box, and reduce your shipping costs.
        </p>
      </div>

      <div class="p-5 sm:p-6 rounded-xl bg-white border border-slate-200 space-y-2.5 sm:space-y-3 shadow-2xs">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-red-50 text-[#EA1D2C] flex items-center justify-center font-bold text-base sm:text-lg font-mono">
          03
        </div>
        <h3 class="text-base sm:text-lg font-bold text-slate-900 font-['Manrope']">Safe Delivery to Your Door</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Once your cargo clears Dhaka airport or Chittagong port, our domestic delivery fleet delivers safely to your shop, office, or residence anywhere in Bangladesh.
        </p>
      </div>
    </div>

    <!-- 5-Step DDP Timeline -->
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 sm:p-8 lg:p-10 space-y-4 sm:space-y-6 shadow-2xs">
      <div class="space-y-1">
        <span class="text-xs font-mono font-bold text-[#EA1D2C] uppercase tracking-wider">/WORKFLOW</span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-['Manrope']">How Door-to-Door Delivery Works</h2>
        <p class="text-xs sm:text-sm text-slate-600">A seamless 5-stage logistics journey from your Chinese supplier to your doorstep.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 sm:gap-6">
        <div class="space-y-1.5 p-3.5 sm:p-4 rounded-lg bg-white border border-slate-200 shadow-2xs">
          <span class="text-xs font-mono font-bold text-slate-400">STAGE 01</span>
          <h4 class="text-sm font-bold text-slate-900">Supplier Dispatches</h4>
          <p class="text-xs text-slate-600 leading-relaxed">Your factory or seller sends products to your assigned Go Shipping China warehouse address.</p>
        </div>
        <div class="space-y-1.5 p-3.5 sm:p-4 rounded-lg bg-white border border-slate-200 shadow-2xs">
          <span class="text-xs font-mono font-bold text-slate-400">STAGE 02</span>
          <h4 class="text-sm font-bold text-slate-900">Warehouse Receiving</h4>
          <p class="text-xs text-slate-600 leading-relaxed">We inspect cartons, record weight &amp; dimensions, consolidate packages, and prepare export docs.</p>
        </div>
        <div class="space-y-1.5 p-3.5 sm:p-4 rounded-lg bg-white border border-slate-200 shadow-2xs">
          <span class="text-xs font-mono font-bold text-slate-400">STAGE 03</span>
          <h4 class="text-sm font-bold text-slate-900">Air / Sea Transit</h4>
          <p class="text-xs text-slate-600 leading-relaxed">Cargo departs on scheduled flight or container vessel to Bangladesh with live milestone updates.</p>
        </div>
        <div class="space-y-1.5 p-3.5 sm:p-4 rounded-lg bg-white border border-slate-200 shadow-2xs">
          <span class="text-xs font-mono font-bold text-slate-400">STAGE 04</span>
          <h4 class="text-sm font-bold text-slate-900">Customs Clearance</h4>
          <p class="text-xs text-slate-600 leading-relaxed">Our team pays duty, completes customs inspections, and releases cargo from port / airport.</p>
        </div>
        <div class="space-y-1.5 p-3.5 sm:p-4 rounded-lg bg-white border border-slate-200 shadow-2xs border-l-2 border-l-[#EA1D2C]">
          <span class="text-xs font-mono font-bold text-[#EA1D2C]">STAGE 05</span>
          <h4 class="text-sm font-bold text-slate-900">Doorstep Delivery</h4>
          <p class="text-xs text-slate-600 leading-relaxed">We deliver packages directly to your address in Dhaka, Chittagong, or any district in Bangladesh.</p>
        </div>
      </div>
    </div>

    <!-- Interactive Calculator -->
    <div id="quote-calculator" class="pt-2 sm:pt-4">
      <QuoteCalculatorIsland client:visible />
    </div>

    <!-- FAQ Section -->
    <div class="space-y-4 sm:space-y-6 pt-4 sm:pt-8">
      <div class="space-y-2">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-['Manrope']">Door-to-Door Delivery FAQ</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {faqItems.map(item => (
          <div class="p-4 sm:p-6 rounded-xl bg-white border border-slate-200 space-y-2 shadow-2xs">
            <h3 class="text-sm font-bold text-slate-900 font-['Manrope']">{item.q}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</PublicLayout>
