---
import '../styles/global.css';
import { getSiteOrigin } from '../server/utils/domain';
import { getTrackingConfig } from '../server/utils/tracking';
import TrackingHead from '../components/analytics/TrackingHead.astro';
import TrackingBody from '../components/analytics/TrackingBody.astro';

const redirectUrl = Astro.url.searchParams.get('redirect') || '';
const message = Astro.url.searchParams.get('message') || '';
const siteOrigin = getSiteOrigin(Astro.request);
const trackingConfig = getTrackingConfig();
---

<!doctype html>
<html lang="en" class="overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="alternate icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <title>Sign In | GoShipping Enterprise Gateway</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <TrackingHead config={trackingConfig} siteOrigin={siteOrigin} />
  </head>
  <body class="bg-[#EBF1F6] text-slate-900 min-h-screen flex items-center justify-center p-3 sm:p-6 lg:p-10 font-['Inter',sans-serif] overflow-x-clip">
    <TrackingBody config={trackingConfig} />
    <!-- Main Modal Split Container -->
    <main class="w-full max-w-[1200px] bg-white rounded-xl border border-slate-200 overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[720px]">
        
        <!-- Left Side: Login Form -->
        <div class="lg:col-span-5 p-6 sm:p-10 lg:p-12 flex flex-col justify-between">
          <div class="space-y-6">
            <!-- Brand Wordmark -->
            <div class="flex items-center justify-between">
              <a href="/" class="inline-flex items-center group" aria-label="GoShipping Home">
                <img
                  src="/brand/logo-light.svg"
                  alt="Go Shipping"
                  class="h-9 w-auto object-contain"
                />
              </a>
              <a href="/" class="text-xs text-slate-400 hover:text-slate-700 transition-colors duration-150">
                ← Back to home
              </a>
            </div>

            <!-- Page Title -->
            <div class="pt-2">
              <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 font-['Manrope',sans-serif]">
                Sign In
              </h1>
              <p class="text-xs text-slate-500 mt-1.5">
                Access your real-time shipments, quotations, and customs reports.
              </p>
            </div>

            <!-- Notice / Error Banners -->
            {message === 'logged_out' && (
              <div class="p-3 rounded-md bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 font-medium flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>You have been signed out safely.</span>
              </div>
            )}
            <div id="error-box" class="hidden p-3 rounded-md bg-red-50 border border-red-200 text-xs text-red-700 font-medium"></div>

            <!-- Form -->
            <form id="login-form" class="space-y-4 text-xs">
              <!-- Email Address -->
              <div>
                <label for="email" class="block font-semibold text-slate-700 mb-1.5">Official Email Address</label>
                <input
                  id="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="name@company.com"
                  class="w-full h-11 px-3.5 rounded-md bg-[#F4F6F9] border border-transparent hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-sm text-slate-900 transition-colors duration-150 outline-none"
                />
              </div>

              <!-- Password -->
              <div>
                <div class="flex justify-between items-center mb-1.5">
                  <label for="password" class="block font-semibold text-slate-700">Password</label>
                </div>
                <input
                  id="password"
                  type="password"
                  required
                  autocomplete="current-password"
                  placeholder="••••••••"
                  class="w-full h-11 px-3.5 rounded-md bg-[#F4F6F9] border border-transparent hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-sm text-slate-900 transition-colors duration-150 outline-none"
                />
              </div>

              <!-- Remember & Forgot Password -->
              <div class="flex items-center justify-between pt-1">
                <div class="flex items-center gap-2">
                  <input
                    id="remember"
                    type="checkbox"
                    class="h-4 w-4 rounded border-slate-300 text-[#EA1D2C] focus:ring-[#EA1D2C] accent-[#EA1D2C] cursor-pointer"
                  />
                  <label for="remember" class="text-xs text-slate-600 cursor-pointer select-none">
                    Remember me
                  </label>
                </div>
                <button
                  type="button"
                  id="btn-forgot-password-trigger"
                  class="text-xs text-slate-400 hover:text-[#EA1D2C] hover:underline cursor-pointer transition-colors duration-150"
                >
                  Forgot password?
                </button>
              </div>

              <!-- Brand Colored Primary Action Button -->
              <button
                type="submit"
                id="submit-btn"
                class="w-full h-12 rounded-md bg-[#EA1D2C] text-white font-semibold text-sm hover:bg-[#D41523] active:bg-[#B7101C] transition-colors duration-150 flex items-center justify-center disabled:opacity-50 cursor-pointer"
              >
                Sign In to Portal →
              </button>

              <!-- Customer Registration Link -->
              <div class="pt-3 text-center border-t border-slate-100">
                <p class="text-xs text-slate-500">
                  Don't have a shipping account?{' '}
                  <a
                    href={`/register${redirectUrl ? `?redirect=${encodeURIComponent(redirectUrl)}` : ''}`}
                    class="font-bold text-[#EA1D2C] hover:underline"
                  >
                    Create Account / নিবন্ধন করুন →
                  </a>
                </p>
              </div>
            </form>
          </div>
        </div>

        <!-- Right Side: Platform Visual Showcase -->
        <div class="lg:col-span-7 bg-[#F5F8FC] border-t lg:border-t-0 lg:border-l border-slate-200 p-6 sm:p-8 lg:p-10 flex flex-col justify-between relative overflow-hidden">
          <!-- Headline Banner -->
          <div class="text-center max-w-lg mx-auto pt-2 pb-6 relative z-10">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight font-['Manrope',sans-serif] leading-tight">
              Manage every shipment in one place.
            </h2>
            <p class="text-slate-600 font-medium text-base sm:text-lg mt-1 tracking-tight">
              Smarter logistics, faster decisions.
            </p>
          </div>

          <!-- Realistic Floating Dashboard Preview Mockup -->
          <div class="relative z-10 w-full max-w-[550px] mx-auto bg-white rounded-lg border border-slate-200 overflow-hidden flex flex-col text-[11px]">
            <!-- Top App Bar / Window Controls -->
            <div class="h-9 bg-slate-50 border-b border-slate-200 px-3 flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-red-400 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block"></span>
                <span class="ml-2 font-bold text-[10px] text-slate-600 tracking-tight font-['Manrope']">
                  GoShipping Enterprise Console
                </span>
              </div>
              <div class="flex items-center gap-2 text-slate-400 text-[10px]">
                <span class="bg-white px-2 py-0.5 rounded border border-slate-200">Search ⌘F</span>
              </div>
            </div>

            <!-- Inner Split: Sidebar + Dashboard Content -->
            <div class="flex flex-row min-h-[360px] bg-white">
              <!-- Mini Sidebar -->
              <div class="w-36 bg-[#FBFBFC] border-r border-slate-100 p-2.5 flex flex-col justify-between hidden sm:flex shrink-0">
                <div class="space-y-1">
                  <div class="px-2 py-1 text-[11px] font-bold text-slate-900 tracking-tight flex items-center gap-1.5">
                    <span class="text-[#EA1D2C] font-extrabold">/</span>fenderr
                  </div>
                  <div class="pt-2 text-[9px] font-bold text-slate-400 uppercase tracking-wider px-2">Main Menu</div>
                  <div class="space-y-0.5 pt-1">
                    <div class="flex items-center gap-1.5 px-2 py-1.5 rounded-md bg-blue-50/80 text-blue-600 font-semibold">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                      </svg>
                      Dashboard
                    </div>
                    <div class="flex items-center gap-1.5 px-2 py-1.5 rounded-md text-slate-600 hover:bg-slate-100/70">
                      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                      </svg>
                      Shipments
                    </div>
                    <div class="flex items-center gap-1.5 px-2 py-1.5 rounded-md text-slate-600 hover:bg-slate-100/70">
                      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                      </svg>
                      Dispatch
                    </div>
                    <div class="flex items-center gap-1.5 px-2 py-1.5 rounded-md text-slate-600 hover:bg-slate-100/70">
                      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                      Drivers
                    </div>
                    <div class="flex items-center gap-1.5 px-2 py-1.5 rounded-md text-slate-600 hover:bg-slate-100/70">
                      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                      </svg>
                      Reports
                    </div>
                  </div>
                </div>

                <!-- Mini Upgrade Card -->
                <div class="p-2 rounded-md bg-blue-50/70 border border-blue-100 text-[9px] space-y-1">
                  <span class="inline-block px-1.5 py-0.5 rounded bg-blue-600 text-white font-bold text-[8px]">
                    20 days left
                  </span>
                  <p class="text-slate-600 font-medium">Upgrade to premium and enjoy benefits</p>
                  <button type="button" class="w-full py-1 rounded bg-white border border-slate-200 text-slate-800 font-bold hover:bg-slate-50">
                    View plan
                  </button>
                </div>
              </div>

              <!-- Mini Main Area -->
              <div class="flex-1 p-3 space-y-3 overflow-hidden bg-white">
                <!-- Header -->
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="font-bold text-slate-900 text-xs font-['Manrope']">Dashboard</h3>
                    <p class="text-[10px] text-slate-400">Fast Actions</p>
                  </div>
                </div>

                <!-- 3 Fast Action Cards -->
                <div class="grid grid-cols-3 gap-1.5">
                  <div class="p-2 rounded-md border border-slate-200 bg-[#FAFCFE] flex flex-col justify-between">
                    <span class="w-5 h-5 rounded-sm bg-blue-100 text-blue-600 flex items-center justify-center">
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                    </span>
                    <div class="mt-2">
                      <span class="text-[9px] text-slate-400 block">Quick Dispatch</span>
                      <strong class="text-[10px] text-slate-800 leading-tight block">Create shipment</strong>
                    </div>
                  </div>
                  <div class="p-2 rounded-md border border-slate-200 bg-[#FAFCFE] flex flex-col justify-between">
                    <span class="w-5 h-5 rounded-sm bg-emerald-100 text-emerald-600 flex items-center justify-center">
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    <div class="mt-2">
                      <span class="text-[9px] text-slate-400 block">Verify Driver</span>
                      <strong class="text-[10px] text-slate-800 leading-tight block">Customs check</strong>
                    </div>
                  </div>
                  <div class="p-2 rounded-md border border-slate-200 bg-[#FAFCFE] flex flex-col justify-between">
                    <span class="w-5 h-5 rounded-sm bg-purple-100 text-purple-600 flex items-center justify-center font-bold text-[10px]">
                      ▤
                    </span>
                    <div class="mt-2">
                      <span class="text-[9px] text-slate-400 block">Manifest</span>
                      <strong class="text-[10px] text-slate-800 leading-tight block">Upload AWB</strong>
                    </div>
                  </div>
                </div>

                <!-- Shipments Overview Chart Box -->
                <div class="p-2.5 rounded-md border border-slate-200 bg-white space-y-1.5">
                  <div class="flex items-center justify-between">
                    <strong class="text-[10px] text-slate-800">Shipments Overview</strong>
                    <span class="text-[9px] text-slate-400">Monthly</span>
                  </div>
                  <div class="flex items-center gap-3 text-[10px]">
                    <div>
                      <span class="text-slate-400">Total Delivery:</span>
                      <strong class="text-slate-900 ml-1">343,254</strong>
                      <span class="text-emerald-600 text-[8px] font-bold ml-1">↗ 12%</span>
                    </div>
                    <div>
                      <span class="text-slate-400">One Delivery:</span>
                      <strong class="text-slate-900 ml-1">25,254</strong>
                      <span class="text-blue-600 text-[8px] font-bold ml-1">↗ 10%</span>
                    </div>
                  </div>

                  <!-- Mini SVG Trend Line with Tooltip -->
                  <div class="relative pt-1">
                    <svg viewBox="0 0 320 65" class="w-full h-16 overflow-visible">
                      <defs>
                        <linearGradient id="gradient-blue" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.25" />
                          <stop offset="100%" stop-color="#3B82F6" stop-opacity="0.0" />
                        </linearGradient>
                      </defs>
                      <!-- Area Fill -->
                      <path d="M 0,55 Q 50,50 80,42 T 160,25 T 230,20 T 320,12 L 320,65 L 0,65 Z" fill="url(#gradient-blue)" />
                      <!-- Main Line -->
                      <path d="M 0,55 Q 50,50 80,42 T 160,25 T 230,20 T 320,12" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" />
                      <!-- Second Line -->
                      <path d="M 0,60 Q 60,56 120,48 T 200,38 T 320,28" fill="none" stroke="#93C5FD" stroke-width="1.5" stroke-dasharray="3 3" />
                      <!-- Active Point July -->
                      <circle cx="230" cy="20" r="3.5" fill="#2563EB" stroke="#FFFFFF" stroke-width="2" />
                    </svg>

                    <!-- Active Hover Tooltip -->
                    <div class="absolute top-0 right-14 bg-slate-900 text-white rounded px-2 py-0.5 text-[8px] flex items-center gap-1.5">
                      <span class="text-blue-300">Delivery: 1,420</span>
                      <span class="text-slate-400">|</span>
                      <span class="text-emerald-300">On Delivery: 380</span>
                    </div>

                    <!-- Month axis -->
                    <div class="flex justify-between text-[8px] text-slate-400 pt-1">
                      <span>Jan</span><span>Mar</span><span>May</span><span>July</span><span>Sep</span><span>Nov</span>
                    </div>
                  </div>
                </div>

                <!-- Active Shipments Table Strip -->
                <div class="border border-slate-200 rounded-md overflow-hidden text-[9px]">
                  <div class="bg-slate-50 px-2 py-1 font-bold text-slate-500 flex justify-between">
                    <span>Tracking no</span>
                    <span>Route</span>
                    <span>Status</span>
                  </div>
                  <div class="divide-y divide-slate-100 bg-white">
                    <div class="px-2 py-1 flex items-center justify-between">
                      <span class="font-mono font-semibold text-slate-900">#GS-876364</span>
                      <span class="text-slate-500 truncate max-w-[100px]">LAX → PHX</span>
                      <span class="px-1.5 py-0.5 rounded-sm bg-blue-50 text-blue-700 font-semibold text-[8px]">In Transit</span>
                    </div>
                    <div class="px-2 py-1 flex items-center justify-between">
                      <span class="font-mono font-semibold text-slate-900">#GS-876365</span>
                      <span class="text-slate-500 truncate max-w-[100px]">PVG → DHK</span>
                      <span class="px-1.5 py-0.5 rounded-sm bg-emerald-50 text-emerald-700 font-semibold text-[8px]">Customs OK</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="text-center pt-4 text-[11px] text-slate-500">
            Real-time multi-modal telemetry · Automated customs clearances · Live GPS tracking
          </div>
        </div>

      </div>
    </main>

    <!-- Forgot Password Modal Dialog -->
    <div
      id="forgot-modal"
      class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="forgot-modal-title"
    >
      <div class="bg-white rounded-xl shadow-2xl border border-slate-200 max-w-md w-full p-6 sm:p-7 relative">
        <!-- Close button -->
        <button
          type="button"
          id="btn-close-forgot-modal"
          class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 p-1.5 rounded-md hover:bg-slate-100 transition-colors cursor-pointer"
          aria-label="Close"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <!-- Header -->
        <div class="mb-5">
          <div class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center text-[#EA1D2C] mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <h3 id="forgot-modal-title" class="text-lg font-bold text-slate-900 font-['Manrope']">
            Reset Account Password
          </h3>
          <p class="text-xs text-slate-500 mt-1">
            Enter your registered official email to receive a secure 6-digit verification code.
          </p>
        </div>

        <!-- Notification Message inside Modal -->
        <div id="forgot-modal-alert" class="hidden mb-4 p-3 rounded-md text-xs font-medium"></div>

        <!-- STEP 1: Request OTP Form -->
        <form id="forgot-step1-form" class="space-y-4 text-xs">
          <div>
            <label for="forgot-email" class="block font-semibold text-slate-700 mb-1.5">Registered Email</label>
            <input
              id="forgot-email"
              type="email"
              required
              placeholder="name@company.com"
              class="w-full h-11 px-3.5 rounded-md bg-[#F4F6F9] border border-transparent hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-sm text-slate-900 transition-colors outline-none"
            />
          </div>

          <button
            type="submit"
            id="btn-send-otp"
            class="w-full h-11 rounded-md bg-[#EA1D2C] text-white font-semibold text-sm hover:bg-[#D41523] active:bg-[#B7101C] transition-colors flex items-center justify-center cursor-pointer disabled:opacity-50"
          >
            Send Verification Code →
          </button>
        </form>

        <!-- STEP 2: Verify OTP and Set New Password Form (Initially hidden) -->
        <form id="forgot-step2-form" class="space-y-4 text-xs hidden">
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label for="reset-code" class="block font-semibold text-slate-700">6-Digit Verification Code</label>
              <span class="text-[11px] text-slate-500 truncate max-w-[180px]" id="reset-target-email"></span>
            </div>
            <input
              id="reset-code"
              type="text"
              required
              maxlength="6"
              placeholder="123456"
              class="w-full h-11 px-3.5 rounded-md bg-[#F4F6F9] border border-transparent hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-center font-mono font-bold tracking-widest text-lg text-slate-900 transition-colors outline-none"
            />
          </div>

          <div>
            <label for="reset-new-password" class="block font-semibold text-slate-700 mb-1.5">New Password</label>
            <input
              id="reset-new-password"
              type="password"
              required
              minlength="6"
              placeholder="Minimum 6 characters"
              class="w-full h-11 px-3.5 rounded-md bg-[#F4F6F9] border border-transparent hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-sm text-slate-900 transition-colors outline-none"
            />
          </div>

          <div>
            <label for="reset-confirm-password" class="block font-semibold text-slate-700 mb-1.5">Confirm New Password</label>
            <input
              id="reset-confirm-password"
              type="password"
              required
              minlength="6"
              placeholder="Re-enter new password"
              class="w-full h-11 px-3.5 rounded-md bg-[#F4F6F9] border border-transparent hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-sm text-slate-900 transition-colors outline-none"
            />
          </div>

          <button
            type="submit"
            id="btn-confirm-reset"
            class="w-full h-11 rounded-md bg-[#EA1D2C] text-white font-semibold text-sm hover:bg-[#D41523] active:bg-[#B7101C] transition-colors flex items-center justify-center cursor-pointer disabled:opacity-50"
          >
            Update Password & Sign In →
          </button>

          <div class="text-center pt-1">
            <button
              type="button"
              id="btn-back-to-step1"
              class="text-xs text-slate-500 hover:text-slate-800 transition-colors cursor-pointer"
            >
              ← Change email address
            </button>
          </div>
        </form>

        <!-- WhatsApp Emergency Assistance -->
        <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
          <span>Need immediate assistance?</span>
          <a
            id="forgot-whatsapp-link"
            href="https://wa.me/8801797252627?text=Hello%20GoShipping%2C%20I%20need%20help%20recovering%20my%20account%20password."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 font-semibold text-emerald-600 hover:text-emerald-700 hover:underline"
          >
            <span>WhatsApp Desk</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.311.045-.698.056-2.18-.553-1.894-.778-3.09-2.73-3.184-2.855-.094-.125-.765-1.018-.765-1.942 0-.923.483-1.378.654-1.564.172-.187.375-.234.5-.234.126 0 .25.002.36.008.115.006.27-.043.422.323.157.38.536 1.309.584 1.405.047.096.079.208.016.333-.063.125-.094.203-.188.312-.093.11-.197.246-.281.33-.094.094-.192.196-.083.383.11.188.487.805 1.045 1.303.719.641 1.326.84 1.514.934.188.093.297.078.406-.047.11-.125.469-.546.594-.734.125-.187.25-.156.422-.094.172.063 1.094.516 1.282.609.188.094.313.141.36.219.046.078.046.453-.098.858z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <script define:vars={{ redirectUrl }}>
      const form = document.getElementById('login-form');
      const errorBox = document.getElementById('error-box');
      const submitBtn = document.getElementById('submit-btn');

      async function executeLogin(email, password) {
        errorBox.classList.add('hidden');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Authenticating...';

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });

          const data = await res.json();
          if (!res.ok) {
            throw new Error(data.error || 'Authentication failed');
          }

          if (typeof window !== 'undefined' && window.goShippingTrack) {
            window.goShippingTrack('Login', {
              user_id: data.user?.id,
              role: data.user?.role,
              method: 'password'
            });
          }

          submitBtn.textContent = 'Redirecting...';

          const isStaff = ['super_admin', 'ops_manager', 'warehouse_staff', 'sales_team', 'support_agent'].includes(data.user?.role);

          if (redirectUrl) {
            if (!isStaff && redirectUrl.startsWith('/admin')) {
              window.location.replace('/dashboard');
            } else if (isStaff && redirectUrl.startsWith('/dashboard')) {
              window.location.replace('/admin');
            } else {
              window.location.replace(redirectUrl);
            }
          } else if (!isStaff) {
            window.location.replace('/dashboard');
          } else {
            window.location.replace('/admin');
          }
        } catch (err) {
          errorBox.textContent = err.message || 'Login failed';
          errorBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Sign In to Portal →';
        }
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;
        executeLogin(email, password);
      });

      // Forgot Password Modal Controller
      const forgotModal = document.getElementById('forgot-modal');
      const forgotTrigger = document.getElementById('btn-forgot-password-trigger');
      const forgotClose = document.getElementById('btn-close-forgot-modal');
      const forgotAlert = document.getElementById('forgot-modal-alert');
      const step1Form = document.getElementById('forgot-step1-form');
      const step2Form = document.getElementById('forgot-step2-form');
      const forgotEmail = document.getElementById('forgot-email');
      const resetCode = document.getElementById('reset-code');
      const resetNewPassword = document.getElementById('reset-new-password');
      const resetConfirmPassword = document.getElementById('reset-confirm-password');
      const resetTargetEmail = document.getElementById('reset-target-email');
      const btnSendOtp = document.getElementById('btn-send-otp');
      const btnConfirmReset = document.getElementById('btn-confirm-reset');
      const btnBackStep1 = document.getElementById('btn-back-to-step1');
      const whatsappLink = document.getElementById('forgot-whatsapp-link');

      function showForgotAlert(msg, isSuccess = false) {
        if (!forgotAlert) return;
        forgotAlert.textContent = msg;
        forgotAlert.className = isSuccess
          ? 'mb-4 p-3 rounded-md text-xs font-medium bg-emerald-50 border border-emerald-200 text-emerald-800'
          : 'mb-4 p-3 rounded-md text-xs font-medium bg-red-50 border border-red-200 text-red-700';
        forgotAlert.classList.remove('hidden');
      }

      function hideForgotAlert() {
        if (forgotAlert) forgotAlert.classList.add('hidden');
      }

      function openForgotModal() {
        hideForgotAlert();
        const currentEmail = document.getElementById('email')?.value?.trim();
        if (currentEmail && forgotEmail) {
          forgotEmail.value = currentEmail;
          if (whatsappLink) {
            whatsappLink.href = `https://wa.me/8801797252627?text=Hello%20GoShipping%2C%20I%20need%20help%20recovering%20password%20for%20my%20account%20(${encodeURIComponent(currentEmail)}).`;
          }
        }
        step1Form?.classList.remove('hidden');
        step2Form?.classList.add('hidden');
        forgotModal?.classList.remove('hidden');
        setTimeout(() => forgotEmail?.focus(), 50);
      }

      function closeForgotModal() {
        forgotModal?.classList.add('hidden');
      }

      forgotTrigger?.addEventListener('click', openForgotModal);
      forgotClose?.addEventListener('click', closeForgotModal);

      // Close on backdrop click
      forgotModal?.addEventListener('click', (e) => {
        if (e.target === forgotModal) closeForgotModal();
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && forgotModal && !forgotModal.classList.contains('hidden')) {
          closeForgotModal();
        }
      });

      btnBackStep1?.addEventListener('click', () => {
        hideForgotAlert();
        step2Form?.classList.add('hidden');
        step1Form?.classList.remove('hidden');
      });

      // Step 1: Submit email to get OTP
      step1Form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideForgotAlert();
        const email = forgotEmail?.value?.trim();
        if (!email) return;

        if (btnSendOtp) {
          btnSendOtp.disabled = true;
          btnSendOtp.textContent = 'Sending Verification Code...';
        }

        try {
          const res = await fetch('/api/auth/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email })
          });

          const data = await res.json();
          if (!res.ok) {
            throw new Error(data.error || 'Failed to dispatch verification code');
          }

          if (resetTargetEmail) resetTargetEmail.textContent = email;
          step1Form?.classList.add('hidden');
          step2Form?.classList.remove('hidden');
          showForgotAlert(data.message || 'Verification code sent! Please check your email.', true);
          setTimeout(() => resetCode?.focus(), 50);
        } catch (err) {
          showForgotAlert(err.message || 'Unable to process request.');
        } finally {
          if (btnSendOtp) {
            btnSendOtp.disabled = false;
            btnSendOtp.textContent = 'Send Verification Code →';
          }
        }
      });

      // Step 2: Submit OTP and new password
      step2Form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideForgotAlert();

        const email = forgotEmail?.value?.trim();
        const code = resetCode?.value?.trim();
        const newPassword = resetNewPassword?.value;
        const confirmPassword = resetConfirmPassword?.value;

        if (newPassword !== confirmPassword) {
          showForgotAlert('Passwords do not match. Please ensure both passwords are identical.');
          return;
        }

        if (newPassword.length < 6) {
          showForgotAlert('Password must be at least 6 characters long.');
          return;
        }

        if (btnConfirmReset) {
          btnConfirmReset.disabled = true;
          btnConfirmReset.textContent = 'Updating Password...';
        }

        try {
          const res = await fetch('/api/auth/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, code, newPassword })
          });

          const data = await res.json();
          if (!res.ok) {
            throw new Error(data.error || 'Failed to reset password');
          }

          showForgotAlert('Password successfully reset! Signing you in...', true);

          // Populate main login form and auto sign in
          const emailInput = document.getElementById('email');
          const passwordInput = document.getElementById('password');
          if (emailInput) emailInput.value = email;
          if (passwordInput) passwordInput.value = newPassword;

          setTimeout(() => {
            closeForgotModal();
            executeLogin(email, newPassword);
          }, 1000);
        } catch (err) {
          showForgotAlert(err.message || 'Verification code is invalid or expired.');
          if (btnConfirmReset) {
            btnConfirmReset.disabled = false;
            btnConfirmReset.textContent = 'Update Password & Sign In →';
          }
        }
      });
    </script>
  </body>
</html>
