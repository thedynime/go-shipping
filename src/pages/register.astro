---
import '../styles/global.css';
import { getSiteOrigin } from '../server/utils/domain';
import { getTrackingConfig } from '../server/utils/tracking';
import TrackingHead from '../components/analytics/TrackingHead.astro';
import TrackingBody from '../components/analytics/TrackingBody.astro';

const redirectUrl = Astro.url.searchParams.get('redirect') || '/dashboard';
const siteOrigin = getSiteOrigin(Astro.request);
const trackingConfig = getTrackingConfig();
---

<!doctype html>
<html lang="en" class="overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="alternate icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <title>Customer Registration | GoShipping Enterprise Gateway</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <TrackingHead config={trackingConfig} siteOrigin={siteOrigin} />
  </head>
  <body class="bg-[#EBF1F6] text-slate-900 min-h-screen flex items-center justify-center p-3 sm:p-6 lg:p-10 font-['Inter',sans-serif] overflow-x-clip">
    <TrackingBody config={trackingConfig} />

    <!-- Main Modal Split Container -->
    <main class="w-full max-w-[1200px] bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
      <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[720px]">
        
        <!-- Left Side: Registration Form -->
        <div class="lg:col-span-6 p-6 sm:p-10 lg:p-12 flex flex-col justify-between">
          <div class="space-y-6">
            <!-- Brand Wordmark & Back Link -->
            <div class="flex items-center justify-between">
              <a href="/" class="inline-flex items-center group" aria-label="GoShipping Home">
                <img
                  src="/brand/logo-light.svg"
                  alt="Go Shipping"
                  class="h-9 w-auto object-contain"
                />
              </a>
              <a href="/login" class="text-xs text-slate-500 hover:text-[#EA1D2C] transition-colors">
                Already registered? <strong>Sign In</strong> →
              </a>
            </div>

            <!-- Page Title -->
            <div class="pt-1">
              <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-red-50 text-[#EA1D2C] border border-red-200 uppercase tracking-wider mb-2 font-mono">
                Customer Account
              </div>
              <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 font-['Manrope',sans-serif]">
                Create Your Account
              </h1>
              <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                Register to track live consignments, manage China warehouse marks, and download commercial customs invoices.
              </p>
            </div>

            <!-- Error Banner -->
            <div id="error-box" class="hidden p-3 rounded-md bg-red-50 border border-red-200 text-xs text-red-700 font-medium"></div>

            <!-- Success Banner -->
            <div id="success-box" class="hidden p-3 rounded-md bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 font-medium flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>Account created successfully! Redirecting you to dashboard…</span>
            </div>

            <!-- Registration Form -->
            <form id="register-form" class="space-y-3.5 text-xs">
              <!-- Full Name -->
              <div>
                <label for="fullName" class="block font-semibold text-slate-700 mb-1">
                  Full Name <span class="text-[#EA1D2C]">*</span>
                </label>
                <input
                  id="fullName"
                  name="fullName"
                  type="text"
                  required
                  placeholder="e.g. Tanvir Ahmed"
                  class="w-full h-10 px-3.5 rounded-md bg-[#F4F6F9] border border-transparent hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-xs sm:text-sm text-slate-900 transition-colors outline-none font-medium"
                />
              </div>

              <!-- Two-column: Email & Phone -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="email" class="block font-semibold text-slate-700 mb-1">
                    Email Address <span class="text-[#EA1D2C]">*</span>
                  </label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    autocomplete="email"
                    placeholder="tanvir@company.com"
                    class="w-full h-10 px-3.5 rounded-md bg-[#F4F6F9] border border-transparent hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-xs sm:text-sm text-slate-900 transition-colors outline-none font-medium"
                  />
                </div>

                <div>
                  <label for="phone" class="block font-semibold text-slate-700 mb-1">
                    Phone / WhatsApp <span class="text-[#EA1D2C]">*</span>
                  </label>
                  <input
                    id="phone"
                    name="phone"
                    type="tel"
                    required
                    placeholder="017XXXXXXXX"
                    class="w-full h-10 px-3.5 rounded-md bg-[#F4F6F9] border border-transparent hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-xs sm:text-sm text-slate-900 transition-colors outline-none font-medium"
                  />
                </div>
              </div>

              <!-- Company / Trade Name -->
              <div>
                <label for="companyName" class="block font-semibold text-slate-700 mb-1">
                  Company / Trade Name <span class="text-slate-400 font-normal">(Optional)</span>
                </label>
                <input
                  id="companyName"
                  name="companyName"
                  type="text"
                  placeholder="e.g. Bengal Fashion Ltd / E-commerce Shop"
                  class="w-full h-10 px-3.5 rounded-md bg-[#F4F6F9] border border-transparent hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-xs sm:text-sm text-slate-900 transition-colors outline-none font-medium"
                />
              </div>

              <!-- Password & Confirm Password -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="password" class="block font-semibold text-slate-700 mb-1">
                    Password <span class="text-[#EA1D2C]">*</span>
                  </label>
                  <input
                    id="password"
                    name="password"
                    type="password"
                    required
                    minlength="6"
                    placeholder="••••••••"
                    class="w-full h-10 px-3.5 rounded-md bg-[#F4F6F9] border border-transparent hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-xs sm:text-sm text-slate-900 transition-colors outline-none font-medium"
                  />
                  <p class="text-[10px] text-slate-400 mt-1">Minimum 6 characters</p>
                </div>

                <div>
                  <label for="confirmPassword" class="block font-semibold text-slate-700 mb-1">
                    Confirm Password <span class="text-[#EA1D2C]">*</span>
                  </label>
                  <input
                    id="confirmPassword"
                    name="confirmPassword"
                    type="password"
                    required
                    minlength="6"
                    placeholder="••••••••"
                    class="w-full h-10 px-3.5 rounded-md bg-[#F4F6F9] border border-transparent hover:border-slate-300 focus:bg-white focus:border-[#EA1D2C] focus:ring-2 focus:ring-[#EA1D2C]/15 text-xs sm:text-sm text-slate-900 transition-colors outline-none font-medium"
                  />
                </div>
              </div>

              <!-- Terms Checkbox -->
              <div class="flex items-start gap-2 pt-1">
                <input
                  id="agreeTerms"
                  type="checkbox"
                  required
                  class="mt-0.5 h-4 w-4 rounded border-slate-300 text-[#EA1D2C] focus:ring-[#EA1D2C] accent-[#EA1D2C] cursor-pointer"
                />
                <label for="agreeTerms" class="text-[11px] text-slate-600 cursor-pointer select-none leading-relaxed">
                  I agree to GoShipping's <a href="/terms" class="text-[#EA1D2C] underline">Terms of Service</a> and privacy guidelines for cross-border cargo handling.
                </label>
              </div>

              <!-- Primary Submit Button -->
              <button
                type="submit"
                id="submit-btn"
                class="w-full h-11 rounded-md bg-[#EA1D2C] text-white font-semibold text-sm hover:bg-[#D41523] active:bg-[#B7101C] transition-colors flex items-center justify-center disabled:opacity-50 cursor-pointer shadow-xs"
              >
                Create Account & Sign In →
              </button>

              <div class="pt-3 text-center border-t border-slate-100">
                <p class="text-xs text-slate-500">
                  Already have an account?{' '}
                  <a href={`/login${redirectUrl ? `?redirect=${encodeURIComponent(redirectUrl)}` : ''}`} class="font-bold text-[#EA1D2C] hover:underline">
                    Sign in to Portal →
                  </a>
                </p>
              </div>
            </form>
          </div>

          <div class="pt-4 text-center">
            <span class="text-[11px] text-slate-400">
              © {new Date().getFullYear()} GoShipping Logistics Ltd. All rights reserved.
            </span>
          </div>
        </div>

        <!-- Right Side: Platform Visual Showcase -->
        <div class="lg:col-span-6 bg-[#F5F8FC] border-t lg:border-t-0 lg:border-l border-slate-200 p-6 sm:p-8 lg:p-10 flex flex-col justify-between relative overflow-hidden">
          <div class="text-left max-w-lg mx-auto pt-2 pb-6 relative z-10 space-y-2">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-white text-slate-700 border border-slate-200 shadow-2xs">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>China-to-BD Freight Network</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight font-['Manrope',sans-serif] leading-tight">
              One account for all your imports.
            </h2>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              Unlock your dedicated China warehouse address in Guangzhou and Yiwu. Track every carton, get transparent weight slips, and clear Bangladesh customs hassle-free.
            </p>
          </div>

          <!-- Feature Highlights Matrix -->
          <div class="relative z-10 w-full max-w-lg mx-auto space-y-3">
            <div class="p-3.5 rounded-lg bg-white border border-slate-200/90 shadow-2xs flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-red-50 text-[#EA1D2C] flex items-center justify-center shrink-0 font-bold">
                <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                  <line x1="12" y1="22.08" x2="12" y2="12" />
                </svg>
              </div>
              <div class="min-w-0">
                <h4 class="text-xs font-bold text-slate-900">Unique China Shipping Mark</h4>
                <p class="text-[11px] text-slate-500 truncate">Your suppliers label your packages with your exclusive client code.</p>
              </div>
            </div>

            <div class="p-3.5 rounded-lg bg-white border border-slate-200/90 shadow-2xs flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 font-bold">
                <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
              </div>
              <div class="min-w-0">
                <h4 class="text-xs font-bold text-slate-900">Customs &amp; Duty Included</h4>
                <p class="text-[11px] text-slate-500 truncate">No hidden port charges or surprise tax fees upon arrival in Dhaka.</p>
              </div>
            </div>

            <div class="p-3.5 rounded-lg bg-white border border-slate-200/90 shadow-2xs flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 font-bold">
                <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <rect x="1" y="3" width="15" height="13" />
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
                  <circle cx="5.5" cy="18.5" r="2.5" />
                  <circle cx="18.5" cy="18.5" r="2.5" />
                </svg>
              </div>
              <div class="min-w-0">
                <h4 class="text-xs font-bold text-slate-900">Real-Time Waypoint Tracking</h4>
                <p class="text-[11px] text-slate-500 truncate">From China warehouse intake to flight dispatch and door delivery.</p>
              </div>
            </div>
          </div>

          <div class="pt-6 text-center text-xs text-slate-500">
            Need urgent assistance? Call our Bangladesh desk: <strong class="text-slate-900">01797252627</strong>
          </div>
        </div>

      </div>
    </main>

    <script define:vars={{ redirectUrl }}>
      const form = document.getElementById('register-form');
      const submitBtn = document.getElementById('submit-btn');
      const errorBox = document.getElementById('error-box');
      const successBox = document.getElementById('success-box');

      function showError(msg) {
        if (errorBox) {
          errorBox.textContent = msg;
          errorBox.classList.remove('hidden');
        }
        if (successBox) successBox.classList.add('hidden');
      }

      function hideError() {
        if (errorBox) errorBox.classList.add('hidden');
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();

        const fullName = document.getElementById('fullName')?.value?.trim();
        const email = document.getElementById('email')?.value?.trim();
        const phone = document.getElementById('phone')?.value?.trim();
        const companyName = document.getElementById('companyName')?.value?.trim();
        const password = document.getElementById('password')?.value;
        const confirmPassword = document.getElementById('confirmPassword')?.value;

        if (!fullName || !email || !phone || !password) {
          showError('Please fill in all mandatory fields (*)');
          return;
        }

        if (password.length < 6) {
          showError('Password must be at least 6 characters long.');
          return;
        }

        if (password !== confirmPassword) {
          showError('Passwords do not match. Please ensure both passwords are identical.');
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Creating Account…';
        }

        try {
          const res = await fetch('/api/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fullName, email, phone, companyName, password })
          });

          const data = await res.json();
          if (!res.ok) {
            throw new Error(data.error || 'Registration failed. Please try again.');
          }

          if (successBox) successBox.classList.remove('hidden');
          setTimeout(() => {
            window.location.href = redirectUrl || '/dashboard';
          }, 800);
        } catch (err) {
          showError(err.message || 'Registration failed. Please try again.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Create Account & Sign In →';
          }
        }
      });
    </script>
  </body>
</html>
