  <!-- Client-side script for lead form submission -->
  <script>
    const form = document.getElementById('lead-intake-form');
    const submitBtn = document.getElementById('lead-submit-btn');
    const alertBox = document.getElementById('lead-alert-box');
    const successBox = document.getElementById('lead-success-box');
    const successMsg = document.getElementById('lead-success-msg');
    const waLink = document.getElementById('whatsapp-followup-link');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (alertBox) {
        alertBox.classList.add('hidden');
        alertBox.className = 'hidden p-3 rounded-lg text-xs font-medium';
      }

      const name = (document.getElementById('leadName') as HTMLInputElement)?.value?.trim();
      const phone = (document.getElementById('leadPhone') as HTMLInputElement)?.value?.trim();
      const productName = (document.getElementById('leadProductName') as HTMLInputElement)?.value?.trim();
      const estimatedQty = (document.getElementById('leadQty') as HTMLInputElement)?.value?.trim();
      const targetPlatform = (document.getElementById('leadPlatform') as HTMLSelectElement)?.value;
      const productUrl = (document.getElementById('leadProductUrl') as HTMLInputElement)?.value?.trim();
      const notes = (document.getElementById('leadNotes') as HTMLTextAreaElement)?.value?.trim();

      if (!name || !phone || !productName) {
        if (alertBox) {
          alertBox.textContent = 'অনুগ্রহ করে লাল তারকা (*) চিহ্নিত সব তথ্য সঠিকভাবে পূরণ করুন।';
          alertBox.className = 'p-3 rounded-lg text-xs font-medium bg-red-50 text-red-700 border border-red-200 block';
        }
        return;
      }

      if (submitBtn) {
        (submitBtn as HTMLButtonElement).disabled = true;
        submitBtn.innerHTML = 'পাঠানো হচ্ছে…';
      }

      try {
        const res = await fetch('/api/sourcing/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            phone,
            productName,
            estimatedQty,
            targetPlatform,
            productUrl,
            notes
          })
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'রিকোয়েস্ট সাবমিট করতে সমস্যা হয়েছে');
        }

        form.classList.add('hidden');
        if (successBox) successBox.classList.remove('hidden');
        if (successMsg) {
          successMsg.textContent = `${name}, আপনার রিকোয়েস্ট (${data.leadRef}) আমাদের সোর্সিং টিমের কাছে পৌঁছেছে। অতি দ্রুত আপনার নম্বরে (${phone}) যোগাযোগ করা হবে।`;
        }
        if (waLink) {
          const waText = encodeURIComponent(`Hello GoShipping, I submitted a sourcing request [${data.leadRef}] for ${productName} (${estimatedQty || 'Qty: TBD'}). Please review.`);
          (waLink as HTMLAnchorElement).href = `https://wa.me/8801797252627?text=${waText}`;
        }

        // Fire multi-platform Ad Pixel conversion tracking (Meta, TikTok, Google Analytics)
        if (typeof window !== 'undefined' && (window as any).goShippingTrack) {
          (window as any).goShippingTrack('Lead', {
            lead_ref: data.leadRef,
            service: 'China Sourcing',
            product_name: productName,
            estimated_qty: estimatedQty,
            source_platform: targetPlatform
          });
        }
      } catch (err: any) {
        if (alertBox) {
          alertBox.textContent = err.message || 'একটি ত্রুটি ঘটেছে। দয়া করে পুনরায় চেষ্টা করুন অথবা সরাসরি হোয়াটসঅ্যাপে যোগাযোগ করুন।';
          alertBox.className = 'p-3 rounded-lg text-xs font-medium bg-red-50 text-red-700 border border-red-200 block';
        }
        if (submitBtn) {
          (submitBtn as HTMLButtonElement).disabled = false;
          submitBtn.innerHTML = 'সোর্সিং অনুসন্ধান পাঠান (Free Consultation) →';
        }
      }
    });
  </script>
