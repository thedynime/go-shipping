---
import PublicLayout from '../layouts/PublicLayout.astro';
import HomeHeroBannerIsland from '../components/marketing/HomeHeroBannerIsland';
import { BannerService } from '../server/services/banner.service';
import { getSiteOrigin } from '../server/utils/domain';

const dynamicBanners = await BannerService.getBanners(true);
const siteOrigin = getSiteOrigin(Astro.request);
const canonicalUrl = `${siteOrigin}/sourcing`;

const sourcingSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      "url": canonicalUrl,
      "name": "চায়না প্রোডাক্ট সোর্সিং ও শিপিং সার্ভিস — GoShipping",
      "provider": {
        "@type": "Organization",
        "name": "GoShipping Logistics",
        "url": siteOrigin,
        "telephone": "+8801797252627",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "43/31, Near of SabujKanon Jame Masjid, Sabujbagh",
          "addressLocality": "Dhaka",
          "postalCode": "1214",
          "addressCountry": "BD"
        }
      },
      "areaServed": "Bangladesh",
      "description": "চায়না থেকে সরাসরি ফ্যাক্টরি রেটে পণ্য সোর্সিং, সাপ্লায়ার ভেরিফিকেশন, কোয়ালিটি চেক, আলিপে পেমেন্ট এবং কাস্টমস ক্লিয়ারেন্স সহ বাংলাদেশে ডোর ডেলিভারি সেবা।"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteOrigin },
        { "@type": "ListItem", "position": 2, "name": "সোর্সিং", "item": canonicalUrl }
      ]
    }
  ]
};
---

<PublicLayout
  title="চীন থেকে পণ্য সোর্সিং ও ডেলিভারি | চায়না ফ্যাক্টরি ডিরেক্ট — GoShipping"
  description="1688, Taobao বা সরাসরি চায়না ফ্যাক্টরি থেকে পণ্য সোর্সিং, দরদাম, কোয়ালিটি চেক ও কাস্টমস সহ বাংলাদেশে সম্পূর্ণ ডোর ডেলিভারি। সরাসরি কল করুন: 01797252627"
  keywords="china product sourcing bangladesh, 1688 product sourcing bd, taobao sourcing bd, china factory direct bangladesh, go shipping sourcing"
  currentPath="/sourcing"
  image="/og/og-sourcing.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(sourcingSchema)} />
  </Fragment>

  <!-- ========================================================================= -->
  <!-- 01. DYNAMIC HERO BANNER SYSTEM (China Sourcing & Cargo Operations)         -->
  <!-- ========================================================================= -->
  <HomeHeroBannerIsland client:load initialBanners={dynamicBanners} />

  <!-- 02. Sourcing Highlights Section (Light Theme) -->
  <section class="relative bg-gradient-to-b from-white via-red-50/20 to-slate-50/50 text-slate-900 py-10 sm:py-14 lg:py-18 border-b border-slate-200 overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left: Hero Copy -->
        <div class="lg:col-span-7 space-y-4 sm:space-y-5">
          <!-- Tag Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-red-50 border border-red-200 text-[#EA1D2C]">
            <span class="w-2 h-2 rounded-full bg-[#EA1D2C] animate-pulse"></span>
            <span>চায়না টু বাংলাদেশ প্রফেশনাল সোর্সিং সেবা</span>
          </div>

          <!-- Main Catchy Headline -->
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight font-['Manrope',sans-serif] leading-[1.2] text-slate-900">
            চীন থেকে সরাসরি <span class="text-[#EA1D2C]">ফ্যাক্টরি রেটে</span> পণ্য সোর্সিং ও ঝামেলামুক্ত ডেলিভারি
          </h1>

          <!-- Value Statement -->
          <p class="text-xs sm:text-sm lg:text-base text-slate-600 leading-relaxed max-w-2xl">
            1688, Taobao, Alibaba বা সরাসরি চায়না উৎপাদকদের কাছ থেকে সঠিক সাপ্লায়ার অনুসন্ধান, দাম নেগোসিয়েশন, ওয়্যারহাউস কোয়ালিটি চেকিং ও কাস্টমস ক্লিয়ারেন্স সহ সম্পূর্ণ ডোর ডেলিভারি এখন এক ছাদের নিচে।
          </p>

          <!-- Key Trust Badges -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3 pt-2 text-xs">
            <div class="p-3 rounded-xl bg-white border border-slate-200 shadow-2xs">
              <span class="block text-slate-500 text-[10px]">সাপ্লায়ার নেটওয়ার্ক</span>
              <strong class="text-slate-900 font-bold text-xs sm:text-sm">৫০০০+ ভেরিফায়েড ফ্যাক্টরি</strong>
            </div>
            <div class="p-3 rounded-xl bg-white border border-slate-200 shadow-2xs">
              <span class="block text-slate-500 text-[10px]">গুয়াংজু ওয়্যারহাউস</span>
              <strong class="text-slate-900 font-bold text-xs sm:text-sm">১০০% কোয়ালিটি চেক</strong>
            </div>
            <div class="p-3 rounded-xl bg-white border border-slate-200 shadow-2xs col-span-2 sm:col-span-1">
              <span class="block text-slate-500 text-[10px]">কাস্টমস ও শুল্ক</span>
              <strong class="text-slate-900 font-bold text-xs sm:text-sm">সম্পূর্ণ অল-ইনক্লুসিভ</strong>
            </div>
          </div>

          <!-- Call to Action Buttons -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <a
              href="#sourcing-form"
              class="min-h-[44px] flex items-center justify-center px-6 py-3 rounded-lg bg-[#EA1D2C] hover:bg-[#D41523] text-white font-bold text-xs sm:text-sm uppercase tracking-wider transition-colors shadow-xs gap-2 text-center"
            >
              <span>ফ্রি সোর্সিং রিকোয়েস্ট পাঠান</span>
              <svg class="w-4 h-4 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>

            <a
              href="https://wa.me/8801797252627?text=Hello%20GoShipping,%20I%20want%20to%20source%20products%20from%20China."
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] flex items-center justify-center px-5 py-3 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm transition-colors gap-2 text-center"
            >
              <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.12.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.12-.23-.19-.48-.31z" />
              </svg>
              <span>হোয়াটসঅ্যাপে কথা বলুন</span>
            </a>
          </div>
        </div>

        <!-- Right: Ad Hero Visual Card -->
        <div class="lg:col-span-5">
          <div class="p-5 sm:p-6 rounded-2xl bg-white border border-red-100 shadow-xl space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
              <span class="text-xs font-bold text-slate-900 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                <span>গুয়াংজু ও ইইউ হাব থেকে সরাসরি</span>
              </span>
              <span class="text-[10px] text-[#EA1D2C] font-mono font-bold bg-red-50 px-2 py-0.5 rounded border border-red-200">লাইভ রেসপন্স</span>
            </div>

            <div class="space-y-3">
              <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50/80 border border-slate-100">
                <div class="w-9 h-9 rounded-lg bg-[#EA1D2C] text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-xs">
                  ১
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-900">১০০% ভেরিফায়েড সাপ্লায়ার</h4>
                  <p class="text-[11px] text-slate-500">কোনো মধ্যস্বত্বভোগী ছাড়া সরাসরি প্রকৃত প্রস্তুতকারকের সাথে লেনদেন।</p>
                </div>
              </div>

              <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50/80 border border-slate-100">
                <div class="w-9 h-9 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-xs">
                  ২
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-900">স্যাম্পল ও ফিজিক্যাল ইন্সপেকশন</h4>
                  <p class="text-[11px] text-slate-500">পণ্য শিপমেন্টের আগে চায়নায় আমাদের নিজস্ব লোক দিয়ে মান যাচাই।</p>
                </div>
              </div>

              <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50/80 border border-slate-100">
                <div class="w-9 h-9 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-xs">
                  ৩
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-900">বাংলাদেশি টাকায় পেমেন্ট সেটেলমেন্ট</h4>
                  <p class="text-[11px] text-slate-500">চাইনিজ আরএমবি বা ডলারে লিগ্যাল ওয়েতে সাপ্লায়ারকে পেমেন্ট প্রদান।</p>
                </div>
              </div>
            </div>

            <div class="pt-2 p-3 rounded-xl bg-red-50 border border-red-100 text-center">
              <p class="text-xs text-slate-700">
                জরুরি প্রয়োজনে আমাদের হটলাইন: <strong class="text-[#EA1D2C] font-mono text-sm">01797252627</strong>
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 02. Problem Awareness Section (আপনার সমস্যাগুলো আমরা বুঝি) -->
  <section class="py-14 sm:py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs font-mono font-bold text-[#EA1D2C] uppercase tracking-wider">/CHALLENGES</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-['Manrope',sans-serif]">
          চীন থেকে পণ্য আমদানিতে আপনি কি এই সমস্যায় পড়ছেন?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          প্রপার গাইডেন্স ও নির্ভরযোগ্য লোকাল পার্টনার না থাকলে আন্তর্জাতিক সোর্সিংয়ে লোকসানের ঝুঁকি থাকে।
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1 -->
        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-2xs space-y-2.5">
          <div class="w-9 h-9 rounded-lg bg-red-50 text-[#EA1D2C] flex items-center justify-center font-bold">
            <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
              <line x1="12" y1="9" x2="12" y2="13" />
              <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900">নকল পণ্য বা নিম্নমানের আশঙ্কা</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            ছবি বা ক্যাটালগে এক কোয়ালিটি দেখে অর্ডার করে ডেলিভারির সময় ভাঙাচোরা বা নিম্নমানের পণ্য পাওয়ার ঝুঁকি।
          </p>
        </div>

        <!-- Card 2 -->
        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-2xs space-y-2.5">
          <div class="w-9 h-9 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
            <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <rect x="2" y="5" width="20" height="14" rx="2" />
              <line x1="2" y1="10" x2="22" y2="10" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900">ডলার ও সাপ্লায়ার পেমেন্ট জটিলতা</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            চাইনিজ সাপ্লায়ারদের ব্যাংক একাউন্ট বা উইচ্যাট/আলিপেতে নিরাপদে ও সঠিক রেটে পেমেন্ট পাঠানোর ঝামেলা।
          </p>
        </div>

        <!-- Card 3 -->
        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-2xs space-y-2.5">
          <div class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
            <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900">ভাষাগত সমস্যা ও মিসকমিউনিকেশন</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            চাইনিজ ভাষা না জানার কারণে সঠিক টেকনিক্যাল স্পেসিফিকেশন ও সর্বোত্তম রেটে দরকষাকষি করতে না পারা।
          </p>
        </div>

        <!-- Card 4 -->
        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-2xs space-y-2.5">
          <div class="w-9 h-9 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center font-bold">
            <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="16" y1="13" x2="8" y2="13" />
              <line x1="16" y1="17" x2="8" y2="17" />
              <polyline points="10 9 9 9 8 9" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900">কাস্টমস শুল্ক ও হিডেন খরচ</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            বাংলাদেশে পণ্য পৌঁছানোর পর এয়ারপোর্ট বা পোর্টের অপ্রত্যাশিত ক্লিয়ারেন্স চার্জ ও আমলাতান্ত্রিক দীর্ঘসূত্রিতা।
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- 03. Core Services (আমাদের সমাধান ও সেবাসমূহ) -->
  <section class="py-14 sm:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs font-mono font-bold text-[#EA1D2C] uppercase tracking-wider">/OUR EXPERTISE</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-['Manrope',sans-serif]">
          GoShipping-এর সম্পূর্ণ সোর্সিং সেবা
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          চীন থেকে পণ্য নির্বাচন থেকে শুরু করে আপনার গোডাউনে ডেলিভারি পর্যন্ত প্রতিটি ধাপে আমাদের ডেডিকেটেড টিম কাজ করে।
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Service 1 -->
        <div class="p-6 rounded-xl border border-slate-200 bg-white hover:border-red-200 transition-colors shadow-2xs space-y-3">
          <div class="w-10 h-10 rounded-lg bg-red-50 text-[#EA1D2C] flex items-center justify-center font-bold">
            <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900">ফ্যাক্টরি ও সাপ্লায়ার ভেরিফিকেশন</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
