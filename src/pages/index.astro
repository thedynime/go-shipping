---
import PublicLayout from '../layouts/PublicLayout.astro';
import LiveTrackingIsland from '../components/marketing/LiveTrackingIsland';
import QuoteCalculatorIsland from '../components/marketing/QuoteCalculatorIsland';
import HomeHeroBannerIsland from '../components/marketing/HomeHeroBannerIsland';
import { BannerService } from '../server/services/banner.service';
import { TestimonialService } from '../server/services/testimonial.service';

const dynamicBanners = await BannerService.getBanners(true);
const dynamicTestimonials = await TestimonialService.getTestimonials(true);
---

<PublicLayout
  title="Go Shipping | China to Bangladesh Shipping & Logistics"
  description="Reliable Air & Sea Shipment Solutions with Door-to-Door Delivery for businesses and online sellers across Bangladesh."
  keywords="China to Bangladesh shipping, China to Bangladesh logistics, China to Bangladesh air shipment, China to Bangladesh sea shipment, door-to-door delivery Bangladesh, China cargo forwarding, Guangzhou to Dhaka freight, Shenzhen to Chittagong shipping, customs clearance Bangladesh, DDP shipping Bangladesh, China warehouse support, e-commerce shipping Bangladesh, Go Shipping, goshipping.com.bd"
  currentPath="/"
  image="/og/og-home.png"
>
  <!-- ========================================================================= -->
  <!-- 1. DYNAMIC HERO BANNER SYSTEM (China Sourcing & Cargo Operations)         -->
  <!-- ========================================================================= -->
  <HomeHeroBannerIsland client:load initialBanners={dynamicBanners} />

  <!-- ========================================================================= -->
  <!-- 3. HOW IT WORKS: Shipping Made Simple                                     -->
  <!-- ========================================================================= -->
  <section id="how-it-works" class="py-10 sm:py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Category Heading */}
      <span class="text-xs font-bold text-[#EA1D2C] uppercase tracking-wider block mb-2 sm:mb-3 font-mono">
        /HOW IT WORKS
      </span>

      {/* Two-Column Process Header */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start mb-8 sm:mb-12 lg:mb-14">
        <div class="lg:col-span-7">
          <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-[#11181E] tracking-tight leading-[1.12]">
            Shipping Made Simple.<br />
            <span class="text-slate-400 font-medium">Three clear steps from China to your doorstep.</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pl-6">
          <p class="text-xs sm:text-sm lg:text-base text-slate-600 leading-relaxed font-normal">
            No intermediaries and no blind spots. We manage the entire logistics journey from warehouse receiving in China to verified delivery across Bangladesh.
          </p>
        </div>
      </div>

      {/* 3 Authentic Process Cards */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 lg:gap-8">
        {/* Step 1 */}
        <div class="p-5 sm:p-6 lg:p-8 rounded-xl bg-slate-50 border border-slate-200 flex flex-col justify-between space-y-4 sm:space-y-6">
          <div class="space-y-2.5 sm:space-y-3">
            <span class="text-2xl sm:text-3xl font-black text-[#EA1D2C] font-mono">01</span>
            <h3 class="text-lg sm:text-xl font-extrabold text-slate-900">
              Send Your Product Details
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Share your product and shipment information with our team.
            </p>
          </div>
          <div class="pt-3 sm:pt-4 border-t border-slate-200 text-xs text-slate-500 font-mono">
            China Warehouse Receiving Support
          </div>
        </div>

        {/* Step 2 */}
        <div class="p-5 sm:p-6 lg:p-8 rounded-xl bg-slate-50 border border-slate-200 flex flex-col justify-between space-y-4 sm:space-y-6">
          <div class="space-y-2.5 sm:space-y-3">
            <span class="text-2xl sm:text-3xl font-black text-[#EA1D2C] font-mono">02</span>
            <h3 class="text-lg sm:text-xl font-extrabold text-slate-900">
              Get Your Shipping Quote
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              We calculate the shipping cost and provide the available options.
            </p>
          </div>
          <div class="pt-3 sm:pt-4 border-t border-slate-200 text-xs text-slate-500 font-mono">
            Transparent Air & Sea Freight Rates
          </div>
        </div>

        {/* Step 3 */}
        <div class="p-5 sm:p-6 lg:p-8 rounded-xl bg-slate-50 border border-slate-200 flex flex-col justify-between space-y-4 sm:space-y-6">
          <div class="space-y-2.5 sm:space-y-3">
            <span class="text-2xl sm:text-3xl font-black text-[#EA1D2C] font-mono">03</span>
            <h3 class="text-lg sm:text-xl font-extrabold text-slate-900">
              Receive Your Shipment
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              We handle the logistics and deliver your cargo to Bangladesh.
            </p>
          </div>
          <div class="pt-3 sm:pt-4 border-t border-slate-200 text-xs text-slate-500 font-mono">
            Door-to-Door Delivery Across 64 Districts
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- ABOUT GO SHIPPING & SHIPPING METHOD SELECTION                             -->
  <!-- ========================================================================= -->
  <section id="about" class="py-10 sm:py-16 lg:py-20 bg-[#F8FAFC] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        {/* Left Column: About Go Shipping */}
        <div class="lg:col-span-6 space-y-4 sm:space-y-6">
          <span class="text-xs font-bold text-[#EA1D2C] uppercase tracking-wider block font-mono">
            China → BD End-to-end support
          </span>
          <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-[#11181E] tracking-tight leading-[1.12]">
            About Go Shipping<br />
            <span class="text-slate-400 font-medium">Your Trusted China to Bangladesh Shipping Partner</span>
          </h2>
          <p class="text-xs sm:text-sm lg:text-base text-slate-600 leading-relaxed font-normal">
            We help online sellers, e-commerce businesses and importers move products from China to Bangladesh with reliable shipping and door-to-door logistics support.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3 pt-2 text-xs font-bold text-slate-800">
            <div class="flex items-center gap-2.5 p-2.5 sm:p-3 rounded-lg bg-white border border-slate-200">
              <span class="w-2 h-2 rounded-full bg-[#EA1D2C]"></span>
              China Warehouse Support
            </div>
            <div class="flex items-center gap-2.5 p-2.5 sm:p-3 rounded-lg bg-white border border-slate-200">
              <span class="w-2 h-2 rounded-full bg-[#EA1D2C]"></span>
              Safe & Secure Cargo Handling
            </div>
            <div class="flex items-center gap-2.5 p-2.5 sm:p-3 rounded-lg bg-white border border-slate-200">
              <span class="w-2 h-2 rounded-full bg-[#EA1D2C]"></span>
              Door-to-Door Delivery
            </div>
            <div class="flex items-center gap-2.5 p-2.5 sm:p-3 rounded-lg bg-white border border-slate-200">
              <span class="w-2 h-2 rounded-full bg-[#EA1D2C]"></span>
              Customs Clearance Support
            </div>
            <div class="flex items-center gap-2.5 p-2.5 sm:p-3 rounded-lg bg-white border border-slate-200 sm:col-span-2">
              <span class="w-2 h-2 rounded-full bg-[#EA1D2C]"></span>
              Small & Large Shipment Accepted
            </div>
          </div>
          <div class="pt-2">
            <a
              href="/services"
              class="inline-flex items-center justify-center px-6 py-2.5 sm:py-3 rounded-md bg-[#11181E] text-white text-xs font-bold hover:bg-slate-800 transition-colors duration-150 border border-[#11181E]"
            >
              Learn More
            </a>
          </div>
        </div>

        {/* Right Column: Air or Sea Comparison Card */}
        <div class="lg:col-span-6">
          <div class="p-5 sm:p-8 lg:p-10 rounded-xl bg-white border border-slate-200 space-y-5 sm:space-y-6">
            <div>
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block font-mono">
                /BY AIR, BY SHIP &amp; HAND CARRY
              </span>
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-black text-slate-900 tracking-tight mt-1">
                Choose the Right Shipping Method
              </h3>
              <p class="text-xs text-slate-500 italic mt-1">
                Delivery times are approximate service estimates and are not guaranteed.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 pt-2">
              {/* By Air */}
              <div class="p-4 sm:p-5 rounded-lg bg-slate-50 border border-slate-200 space-y-2">
                <span class="text-[11px] font-bold text-[#EA1D2C] uppercase tracking-wider block font-mono">
                  Approx. transit
                </span>
                <div class="text-sm sm:text-base font-black text-slate-900">By Air</div>
                <div class="text-xl sm:text-2xl font-black text-[#EA1D2C] font-mono">7–14 Days</div>
                <div class="pt-2.5 border-t border-slate-200 text-xs text-slate-600 space-y-1.5">
                  <div class="font-bold text-slate-900">Best for:</div>
                  <div class="flex items-center gap-1.5"><span class="text-[#EA1D2C]">•</span> Urgent commercial cargo</div>
                  <div class="flex items-center gap-1.5"><span class="text-[#EA1D2C]">•</span> Small &amp; medium packages</div>
                  <div class="flex items-center gap-1.5"><span class="text-[#EA1D2C]">•</span> Time-sensitive apparel &amp; tech</div>
                </div>
              </div>

              {/* By Ship */}
              <div class="p-4 sm:p-5 rounded-lg bg-slate-50 border border-slate-200 space-y-2">
                <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider block font-mono">
                  Approx. transit
                </span>
                <div class="text-sm sm:text-base font-black text-slate-900">By Ship</div>
                <div class="text-xl sm:text-2xl font-black text-slate-900 font-mono">35–45 Days</div>
                <div class="pt-2.5 border-t border-slate-200 text-xs text-slate-600 space-y-1.5">
                  <div class="font-bold text-slate-900">Best for:</div>
                  <div class="flex items-center gap-1.5"><span class="text-slate-400">•</span> Large bulk shipments</div>
                  <div class="flex items-center gap-1.5"><span class="text-slate-400">•</span> Heavy machinery &amp; FCL/LCL</div>
                  <div class="flex items-center gap-1.5"><span class="text-slate-400">•</span> Cost-conscious imports</div>
                </div>
              </div>

              {/* Hand Carry */}
              <div class="p-4 sm:p-5 rounded-lg bg-slate-50 border border-slate-200 space-y-2">
                <span class="text-[11px] font-bold text-amber-600 uppercase tracking-wider block font-mono">
                  Approx. transit
                </span>
                <div class="text-sm sm:text-base font-black text-slate-900">Hand Carry</div>
                <div class="text-xl sm:text-2xl font-black text-amber-600 font-mono">24–48 Hours</div>
                <div class="pt-2.5 border-t border-slate-200 text-xs text-slate-600 space-y-1.5">
                  <div class="font-bold text-slate-900">Best for:</div>
                  <div class="flex items-center gap-1.5"><span class="text-amber-500">•</span> Urgent product samples</div>
                  <div class="flex items-center gap-1.5"><span class="text-amber-500">•</span> Critical electronics &amp; chips</div>
                  <div class="flex items-center gap-1.5"><span class="text-amber-500">•</span> Person-to-person direct transit</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- MOVE WITH CONFIDENCE CTA BANNER                                           -->
  <!-- ========================================================================= -->
  <section class="py-8 sm:py-12 bg-slate-50 text-slate-900 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 sm:gap-8">
        <div class="space-y-1.5 sm:space-y-2 max-w-2xl text-center md:text-left">
          <span class="text-xs font-bold text-[#EA1D2C] uppercase tracking-wider block font-mono">
            Move with Confidence
          </span>
          <h2 class="text-xl sm:text-2xl lg:text-3xl font-extrabold tracking-tight text-[#11181E] font-['Manrope',sans-serif]">
            Looking for a Reliable China to Bangladesh Shipping Partner?
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Tell us what you need to ship and our team will help you choose the right shipping solution.
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-3 shrink-0">
          <a
            href="#quote-section"
            class="px-5 sm:px-6 py-2.5 sm:py-3 rounded-md bg-[#EA1D2C] text-white text-xs font-bold hover:bg-[#D01422] transition-colors duration-150 shadow-xs"
          >
            Get a Quote
          </a>
          <a
            href="https://wa.me/8801797252627?text=Hello%20Go%20Shipping%2C%20I%20would%20like%20a%20shipping%20quote."
            target="_blank"
            rel="noreferrer"
            class="px-5 sm:px-6 py-2.5 sm:py-3 rounded-md border border-emerald-600 bg-white text-emerald-700 text-xs font-bold hover:bg-emerald-50 transition-colors duration-150 inline-flex items-center gap-2 shadow-2xs"
          >
            WhatsApp Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. WHY GOSHIPPING: Why Businesses Choose Go Shipping                      -->
  <!-- ========================================================================= -->
  <section id="why-us" class="py-10 sm:py-16 lg:py-20 bg-[#F8FAFC] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <span class="text-xs font-bold text-[#EA1D2C] uppercase tracking-wider block mb-2 sm:mb-3 font-mono">
        /WHY GO SHIPPING
      </span>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start mb-8 sm:mb-12 lg:mb-14">
        <div class="lg:col-span-7">
          <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-[#11181E] tracking-tight leading-[1.12]">
            Why Businesses Choose<br />
            <span class="text-slate-400 font-medium">Go Shipping.</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pl-6">
          <p class="text-xs sm:text-sm lg:text-base text-slate-600 leading-relaxed font-normal">
            Careful planning, transparent communication, and dedicated customer support at every stage of your China-to-Bangladesh supply chain.
          </p>
        </div>
      </div>

      {/* 6 Core Strengths Grid */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {/* Strength 1: Reliable Service */}
        <div class="space-y-3 sm:space-y-4 bg-white p-5 sm:p-6 lg:p-7 rounded-xl border border-slate-200 flex flex-col justify-between shadow-2xs">
          <div class="space-y-2.5 sm:space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-2xl font-black text-[#EA1D2C] font-mono">01</span>
              <div class="w-9 h-9 rounded-md bg-red-50 text-[#EA1D2C] flex items-center justify-center">
                <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                  <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
              </div>
            </div>
            <h3 class="text-base sm:text-lg font-extrabold text-slate-900">
              Reliable Service
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Careful planning and dependable coordination for every shipment.
            </p>
          </div>
        </div>

        {/* Strength 2: Transparent Communication */}
        <div class="space-y-3 sm:space-y-4 bg-white p-5 sm:p-6 lg:p-7 rounded-xl border border-slate-200 flex flex-col justify-between shadow-2xs">
          <div class="space-y-2.5 sm:space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-2xl font-black text-[#EA1D2C] font-mono">02</span>
              <div class="w-9 h-9 rounded-md bg-blue-50 text-blue-600 flex items-center justify-center">
                <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
              </div>
            </div>
            <h3 class="text-base sm:text-lg font-extrabold text-slate-900">
              Transparent Communication
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Clear updates from initial quotation through final delivery.
            </p>
          </div>
        </div>

        {/* Strength 3: Secure Cargo Handling */}
        <div class="space-y-3 sm:space-y-4 bg-white p-5 sm:p-6 lg:p-7 rounded-xl border border-slate-200 flex flex-col justify-between shadow-2xs">
          <div class="space-y-2.5 sm:space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-2xl font-black text-[#EA1D2C] font-mono">03</span>
              <div class="w-9 h-9 rounded-md bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
              </div>
            </div>
            <h3 class="text-base sm:text-lg font-extrabold text-slate-900">
              Secure Cargo Handling
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Practical handling standards protect your goods throughout transit.
            </p>
          </div>
        </div>

        {/* Strength 4: Door-to-Door Delivery */}
        <div class="space-y-3 sm:space-y-4 bg-white p-5 sm:p-6 lg:p-7 rounded-xl border border-slate-200 flex flex-col justify-between shadow-2xs">
          <div class="space-y-2.5 sm:space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-2xl font-black text-[#EA1D2C] font-mono">04</span>
              <div class="w-9 h-9 rounded-md bg-amber-50 text-amber-600 flex items-center justify-center">
                <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                  <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
              </div>
            </div>
            <h3 class="text-base sm:text-lg font-extrabold text-slate-900">
              Door-to-Door Delivery
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              One coordinated journey from the China warehouse to your address.
            </p>
          </div>
        </div>

        {/* Strength 5: China Warehouse Support */}
        <div class="space-y-3 sm:space-y-4 bg-white p-5 sm:p-6 lg:p-7 rounded-xl border border-slate-200 flex flex-col justify-between shadow-2xs">
          <div class="space-y-2.5 sm:space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-2xl font-black text-[#EA1D2C] font-mono">05</span>
              <div class="w-9 h-9 rounded-md bg-purple-50 text-purple-600 flex items-center justify-center">
                <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                </svg>
              </div>
            </div>
            <h3 class="text-base sm:text-lg font-extrabold text-slate-900">
              China Warehouse Support
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Organized receiving and consolidation support before dispatch.
            </p>
          </div>
        </div>

        {/* Strength 6: Dedicated Customer Support */}
        <div class="space-y-3 sm:space-y-4 bg-white p-5 sm:p-6 lg:p-7 rounded-xl border border-slate-200 flex flex-col justify-between shadow-2xs">
          <div class="space-y-2.5 sm:space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-2xl font-black text-[#EA1D2C] font-mono">06</span>
              <div class="w-9 h-9 rounded-md bg-teal-50 text-teal-600 flex items-center justify-center">
                <svg class="w-5 h-5 stroke-[2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
              </div>
            </div>
            <h3 class="text-base sm:text-lg font-extrabold text-slate-900">
              Dedicated Customer Support
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              A responsive team ready to help at every shipping stage.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 5. SHIPMENT VISIBILITY: Track Your Shipment                               -->
  <!-- ========================================================================= -->
  <section id="tracking-section" class="py-10 sm:py-16 lg:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 sm:space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <span class="text-xs font-bold text-[#EA1D2C] uppercase tracking-wider block mb-2 font-mono">
            /SHIPMENT VISIBILITY
          </span>
          <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-[#11181E] tracking-tight leading-[1.12]">
            Track Your Shipment.
          </h2>
          <p class="text-xs sm:text-sm lg:text-base text-slate-600 mt-2 leading-relaxed">
            Enter your tracking information to check your shipment status or open the dedicated tracking portal.
          </p>
        </div>
        <a
          href="/tracking"
          class="inline-flex items-center gap-2 px-4 py-2 sm:py-2.5 rounded-lg border border-slate-300 bg-slate-50 hover:bg-slate-100 text-xs font-bold text-slate-900 transition-colors shrink-0 shadow-xs"
        >
          <span>Open Full Tracking Portal</span>
